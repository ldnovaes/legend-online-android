<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ruffle"
        tools:targetApi="31">
        <!-- Lista de servidores e login oficial. Deitado: o portal só tem layout de desktop. -->
        <activity
            android:name="com.eldialabs.legendonline.LegendActivity"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:screenOrientation="sensorLandscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PanicActivity"
            android:launchMode="singleTask"
            android:exported="false" />
        <!-- Jogo: Ruffle em tela cheia, deitado. -->
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:screenOrientation="sensorLandscape">
            <meta-data android:name="android.app.lib_name" android:value="ruffle_android" />
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.eldialabs.legendonline.LegendActivity" />
        </activity>
    </application>
</manifest>
